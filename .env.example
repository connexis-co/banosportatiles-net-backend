# backend/.env — LOCAL Docker environment only (gitignored).
# bin/setup.sh copies this file and fills every empty secret with a random value.
# Production (https://admin.banosportatiles.net) is configured by deploy/cloudpanel/deploy.sh
# from backend/.env.deploy (see deploy/README.md).

# --- Docker images / ports ---
WP_IMAGE_TAG=7.1-php8.4-apache
WP_CLI_IMAGE_TAG=cli-2.12-php8.4
WP_PORT=8080
MAILPIT_PORT=8025

# --- Database ---
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=
DB_ROOT_PASSWORD=
WP_TABLE_PREFIX=wp_

# --- WordPress install (local) ---
WP_URL=http://localhost:8080
WP_TITLE="BañosPortátiles.net CMS"
WP_ADMIN_USER=bp-admin
WP_ADMIN_EMAIL=admin@banosportatiles.net
WP_ADMIN_PASSWORD=

# --- bp-headless (production defaults in comments) ---
# Public site. Production: https://banosportatiles.net
BP_FRONTEND_URL=http://localhost:4321
# Extra CORS origins (comma separated), e.g. the workers.dev preview.
BP_CORS_ORIGINS=
# Shared with the Astro front: signs POST /bp/v1/leads (HMAC-SHA256).
BP_LEADS_SECRET=
# Signs short-lived preview tokens ({front}/api/preview?uri=…&token=…).
BP_PREVIEW_SECRET=
# Cloudflare Workers Builds deploy hook. Empty = disabled (can also be set in "Ajustes del sitio").
BP_DEPLOY_HOOK_URL=
# Optional webhook (n8n, Make, CRM…) notified on every new lead.
BP_LEADS_WEBHOOK_URL=
# Lead emails (sent by WordPress through SMTP). false = store leads without emailing them.
BP_LEADS_EMAIL=true
# Empty = contacto@banosportatiles.net / connexis.co@gmail.com; BP_LEADS_EMAIL_CC=none disables copies.
BP_LEADS_EMAIL_TO=
BP_LEADS_EMAIL_CC=
# SMTP for wp_mail (production: Brevo smtp-relay.brevo.com:587 + STARTTLS).
# Local: Mailpit with mandatory STARTTLS + AUTH (http://localhost:8025).
BP_SMTP_HOST=mailpit
BP_SMTP_PORT=1025
BP_SMTP_SECURE=tls
BP_SMTP_USER=bp-smtp
BP_SMTP_PASS=
BP_SMTP_FROM=no-reply@banosportatiles.net
BP_SMTP_FROM_NAME="BañosPortátiles.net"

# Seed bundle directory mounted at /opt/bp/seed (must contain bundle.json and optional assets/).
BP_SEED_DIR=./seed-sample
