# backend/.env.deploy — deploy of the headless CMS to CloudPanel (gitignored, chmod 600).
# deploy/cloudpanel/deploy.sh creates it from this file and fills the empty secrets with random
# values on the first real run. Fill in the Brevo credentials, then run the script again.

# --- Server and site ---
SSH_HOST=connexis-prod
# Fixed IP of connexis-prod (DNS A record of CMS_DOMAIN; the IP authorized in Brevo).
SERVER_IP=95.216.153.73
CMS_DOMAIN=admin.banosportatiles.net
FRONTEND_URL=https://banosportatiles.net
PHP_VERSION=8.4
SITE_USER=banosportatiles-cms
# CloudPanel: database names and users only accept letters, digits and hyphens.
DB_NAME=banosportatiles-cms
DB_USER=banosportatiles-cms
VHOST_TEMPLATE=BP-Headless-WordPress-v1

# --- WordPress ---
WP_TITLE="BañosPortátiles.net CMS"
WP_ADMIN_USER=bp-admin
WP_ADMIN_EMAIL=contacto@banosportatiles.net
WP_LOCALE=es_CO
WP_TIMEZONE=America/Bogota

# --- bp-headless ---
# WordPress emails every lead through Brevo (only the server IP is authorized there).
BP_LEADS_EMAIL=true
BP_LEADS_EMAIL_TO=contacto@banosportatiles.net
# Comma separated copies; "none" disables them.
BP_LEADS_EMAIL_CC=connexis.co@gmail.com
# Cloudflare Workers Builds deploy hook (optional; can also be set later in "Ajustes del sitio").
BP_DEPLOY_HOOK_URL=
# Extra CORS origins, comma separated (e.g. the workers.dev preview).
BP_CORS_ORIGINS=
BP_LEADS_WEBHOOK_URL=

# --- SMTP: Brevo (smtp-relay.brevo.com:587, STARTTLS) ---
# BP_SMTP_USER = Brevo SMTP login; BP_SMTP_PASS = Brevo SMTP key (not the API key).
# The sender domain must be authenticated in Brevo (SPF + DKIM) for BP_SMTP_FROM.
BP_SMTP_HOST=smtp-relay.brevo.com
BP_SMTP_PORT=587
BP_SMTP_USER=
BP_SMTP_PASS=
BP_SMTP_FROM=no-reply@banosportatiles.net
BP_SMTP_FROM_NAME="BañosPortátiles.net"

# --- Secrets: generated automatically when empty. BP_LEADS_SECRET must also be set in the Worker. ---
SITE_USER_PASSWORD=
DB_PASSWORD=
WP_ADMIN_PASSWORD=
BP_LEADS_SECRET=
BP_PREVIEW_SECRET=
