# Secrets and local environment (generated by bin/setup.sh)
.env
.env.*
!.env.example

# Dependencies and build artefacts
/vendor/
/node_modules/
/dist/

# Tool caches
/.phpunit.cache/
/.phpunit.result.cache
/.phpstan-cache/
/.pint.cache

# WordPress runtime data (never versioned)
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/debug.log

# Test artefacts
/tests/fixtures/hook-sink/requests.log

# OS / editors
.DS_Store
.idea/
.vscode/
*.log
